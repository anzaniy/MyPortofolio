---
import BaseLayout from "../layouts/BaseLayout.astro";
import { certificates } from "../data/certificates";
import { withBase } from "../config";
---

<BaseLayout title="Sertifikat Pelatihan" sideBarActiveItemID="certificates">
  <h1 class="sr-only">Sertifikat Pelatihan Muhammad Ega Putra Anzani</h1>
  <h2 class="text-3xl w-full font-bold mb-8">Sertifikat Pelatihan</h2>

  <div class="grid gap-6">
    {
      certificates.map((cert) => (
        <details class="group rounded-lg bg-base-200 overflow-hidden border border-base-300">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none hover:bg-base-300/50 [&::-webkit-details-marker]:hidden">
            <h3 class="text-xl font-bold">{cert.title}</h3>
            <svg
              class="shrink-0 transition-transform duration-200 group-open:rotate-180"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <a
            href={withBase(cert.image)}
            target="_blank"
            rel="noopener noreferrer"
            class="block bg-base-100 border-t border-base-300"
            aria-label={`Buka sertifikat ${cert.title} di tab baru`}
          >
            <img
              src={withBase(cert.image)}
              alt={cert.imageAlt}
              width={cert.width}
              height={cert.height}
              decoding="async"
              class="w-full h-auto"
            />
          </a>
        </details>
      ))
    }
  </div>
</BaseLayout>