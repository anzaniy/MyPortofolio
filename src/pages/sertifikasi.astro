---
import BaseLayout from "../layouts/BaseLayout.astro";
import Dual from "../components/Dual.astro";
import { certificates } from "../data/certificates";
import { withBase } from "../config";
---

<BaseLayout title="Training Certificates" sideBarActiveItemID="certificates">
  <h1 class="sr-only">Training Certificates of Muhammad Ega Putra Anzani</h1>
  <h2 class="text-3xl w-full font-bold mb-2"><Dual en="Training Certificates" id="Sertifikat Pelatihan" /></h2>
  <p class="mb-8 text-base-content/70">
    <Dual
      en="Certificates and training I have completed, along with the original documents."
      id="Sertifikat dan pelatihan yang telah saya selesaikan, lengkap dengan dokumen aslinya."
    />
  </p>

  <div class="grid gap-6">
    {
      certificates.map((cert) => (
        <details class="group rounded-lg bg-base-200 overflow-hidden border border-base-300">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none hover:bg-base-300/50 [&::-webkit-details-marker]:hidden">
            <div>
              <h3 class="text-xl font-bold">{cert.title}</h3>
              <p class="font-semibold"><Dual en={cert.issuer.en} id={cert.issuer.id} /></p>
              <p class="text-sm font-light">
                <Dual en={cert.date.en} id={cert.date.id} />
                {cert.period && <Dual en={` · ${cert.period.en}`} id={` · ${cert.period.id}`} />}
              </p>
            </div>
            <svg
              class="shrink-0 transition-transform duration-200 group-open:rotate-180"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <a
            href={withBase(cert.image)}
            target="_blank"
            rel="noopener noreferrer"
            class="block bg-base-100 border-t border-base-300"
            aria-label={`Open ${cert.title} certificate in a new tab`}
          >
            <img
              src={withBase(cert.image)}
              alt={cert.imageAlt.en}
              width={cert.width}
              height={cert.height}
              decoding="async"
              class="w-full h-auto"
            />
          </a>
          <div class="p-5">
            <p class="text-justify"><Dual en={cert.description.en} id={cert.description.id} /></p>
            {cert.credentialId && (
              <p class="text-sm mt-3 opacity-70">
                {cert.credentialLabel && <Dual en={cert.credentialLabel.en} id={cert.credentialLabel.id} />}: {cert.credentialId}
              </p>
            )}
            <a
              class="btn btn-outline btn-sm mt-4"
              href={withBase(cert.image)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Dual en="Open full image" id="Buka gambar penuh" />
            </a>
          </div>
        </details>
      ))
    }
  </div>
</BaseLayout>