---
import { getCollection } from "astro:content";
import ProjectDetail from "../../components/ProjectDetail.astro";
import { withBase } from "../../config";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (project) => project.data.kind === "work"
  );
  const projectsEn = await getCollection("projects-en");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projectEn: projectsEn.find((item) => item.slug === project.slug) },
  }));
}

const { project, projectEn } = Astro.props;
---

<ProjectDetail
  project={project}
  projectEn={projectEn}
  sideBarActiveItemID="work"
  backHref={withBase("/projects")}
  backLabel="Work Project"
/>