---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { withBase } from "../config";
import { getCollection } from "astro:content";

const individualProjects = (await getCollection("projects"))
  .filter((project) => project.data.kind === "individual")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="rounded-lg bg-base-200 overflow-hidden border border-base-300 p-6 sm:p-8 mt-5 mb-10">
    <div class="text-xl py-1">Halo 👋</div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight lg:whitespace-nowrap">Saya Muhammad Ega Putra Anzani</h1>
    <div class="text-xl sm:text-2xl lg:text-3xl py-3 font-bold">Ilmu Komputer · Software Developer</div>
    <div class="py-2">
      <p class="text-lg">
        Lulusan Ilmu Komputer Universitas Lampung. Saya berpengalaman dalam membangun website, sistem, serta game dengan tujuan untuk mengubah masalah nyata menjadi aplikasi yang rapi dan mudah digunakan.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="mailto:egaanzani77@gmail.com" target="_blank">Hubungi Saya</a>
      <a href={withBase("/projects")} class="btn btn-outline">Lihat Project</a>
      <a href={withBase("/cv.pdf")} download class="btn btn-outline">Download CV</a>
    </div>
  </div>

  <div>
    <h2 class="text-3xl w-full font-bold mb-5">Work Project</h2>
  </div>

  <HorizontalCard
    title="Game Edukasi Geometri Analitik"
    desc="Game Visual Novel edukasi bertema Geometri Analitik Bidang, dibangun dengan Ren'Py dari tahap desain hingga pengujian Alpha dan Beta."
    url={withBase("/projects/game-geometri")}
    target="_self"
    badge="GAME"
    headingLevel="h3"
  />
  <HorizontalCard
    title="Sistem Booking Service Honda Kita"
    desc="Pengembangan API booking service yang menerima data dari aplikasi mobile ke sistem Honda Kita, disertai perbaikan tampilan web dan optimasi query database."
    url={withBase("/projects/api-mobile-tdm")}
    target="_self"
    badge="BACKEND"
    headingLevel="h3"
  />
  <HorizontalCard
    title="Website Sekolah SMA Al Kautsar"
    desc="Website sekolah berbasis CodeIgniter 3 yang memuat profil sekolah, data alumni, sejarah, dan dokumentasi kegiatan."
    url={withBase("/projects/website-sekolah")}
    target="_self"
    badge="WEB"
    headingLevel="h3"
  />

  <div>
    <h2 class="text-3xl w-full font-bold mb-5 mt-12">Individual Project</h2>
  </div>

  {
    individualProjects.map((project) => (
      <HorizontalCard
        title={project.data.title}
        desc={project.data.description}
        url={withBase(`/individual-project/${project.slug}`)}
        target="_self"
        badge={project.data.category}
        headingLevel="h3"
      />
    ))
  }
</BaseLayout>
