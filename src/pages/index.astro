---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import Dual from "../components/Dual.astro";
import { withBase } from "../config";
import { getCollection } from "astro:content";
import { thumb } from "../lib/thumb";

const individualProjects = (await getCollection("projects"))
  .filter((project) => project.data.kind === "individual")
  .sort((a, b) => a.data.order - b.data.order);

const projectsEn = await getCollection("projects-en");
const enBySlug = new Map(projectsEn.map((project) => [project.slug, project.data]));
---

<BaseLayout sideBarActiveItemID="home" wide>
  <div class="rounded-lg bg-base-200 overflow-hidden border border-base-300 p-6 sm:p-8 mt-5 mb-10">
    <div class="text-xl py-1"><Dual en="Hello 👋" id="Halo 👋" /></div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight lg:whitespace-nowrap"><Dual en="I'm Muhammad Ega Putra Anzani" id="Saya Muhammad Ega Putra Anzani" /></h1>
    <div class="text-xl sm:text-2xl lg:text-3xl py-3 font-bold"><Dual en="Computer Science · Software Developer" id="Ilmu Komputer · Software Developer" /></div>
    <div class="py-2">
      <p class="text-lg">
        <Dual
          en="Computer Science graduate from Lampung University. I have experience building websites, systems, and games, turning real-world problems into clean and easy-to-use applications."
          id="Lulusan Ilmu Komputer Universitas Lampung. Saya berpengalaman dalam membangun website, sistem, serta game dengan tujuan untuk mengubah masalah nyata menjadi aplikasi yang rapi dan mudah digunakan."
        />
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn" href="mailto:egaanzani77@gmail.com" target="_blank"><Dual en="Contact Me" id="Hubungi Saya" /></a>
      <a href={withBase("/projects")} class="btn btn-outline"><Dual en="View Projects" id="Lihat Project" /></a>
      <a href={withBase("/cv.pdf")} download class="btn btn-outline">Download CV</a>
    </div>
  </div>

  <div class="lg:max-w-[900px] lg:mx-auto">
    <div>
      <h2 class="text-3xl w-full font-bold mb-5">Work Project</h2>
    </div>

    <HorizontalCard
      title="SMA Al Kautsar School Website"
      titleId="Website Sekolah SMA Al Kautsar"
      desc="CodeIgniter 3 school website presenting the school profile, alumni data, history, and activity documentation."
      descId="Website sekolah berbasis CodeIgniter 3 yang memuat profil sekolah, data alumni, sejarah, dan dokumentasi kegiatan."
      img="/images/projects/thumbs/website-sekolah-1.webp"
      url={withBase("/projects/website-sekolah")}
      target="_self"
      badge="WEB"
      headingLevel="h3"
    />
    <HorizontalCard
      title="Honda Kita Service Booking System"
      titleId="Sistem Booking Service Honda Kita"
      desc="Booking service API development that carries data from the mobile app into the Honda Kita system, along with web UI fixes and database query optimization."
      descId="Pengembangan API booking service yang menerima data dari aplikasi mobile ke sistem Honda Kita, disertai perbaikan tampilan web dan optimasi query database."
      img="/images/projects/thumbs/api-mobile-tdm-1.webp"
      url={withBase("/projects/api-mobile-tdm")}
      target="_self"
      badge="BACKEND"
      headingLevel="h3"
    />
    <HorizontalCard
      title="Analytic Geometry Educational Game"
      titleId="Game Edukasi Geometri Analitik"
      desc="An educational Visual Novel game about Plane Analytic Geometry, built with Ren'Py from design through Alpha and Beta testing."
      descId="Game Visual Novel edukasi bertema Geometri Analitik Bidang, dibangun dengan Ren'Py dari tahap desain hingga pengujian Alpha dan Beta."
      img="/images/projects/thumbs/game-geometri-1.webp"
      url={withBase("/projects/game-geometri")}
      target="_self"
      badge="GAME"
      headingLevel="h3"
    />

    <div>
      <h2 class="text-3xl w-full font-bold mb-5 mt-12">Individual Project</h2>
    </div>

    {
      individualProjects.map((project) => (
        <HorizontalCard
          img={thumb(project.data.gallery[0])}
          title={enBySlug.get(project.slug)?.title ?? project.data.title}
          titleId={project.data.title}
          desc={enBySlug.get(project.slug)?.description ?? project.data.description}
          descId={project.data.description}
          url={withBase(`/individual-project/${project.slug}`)}
          target="_self"
          badge={project.data.category}
          headingLevel="h3"
        />
      ))
    }
  </div>
</BaseLayout>