---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import Dual from "../components/Dual.astro";

interface Props {
  project: CollectionEntry<"projects">;
  projectEn?: CollectionEntry<"projects-en">;
  sideBarActiveItemID: string;
  backHref: string;
  backLabel: string;
}

const { project, projectEn, sideBarActiveItemID, backHref, backLabel } = Astro.props;
const { Content: ContentId } = await project.render();
const { Content: ContentEn } = projectEn
  ? await projectEn.render()
  : { Content: ContentId };

const titleEn = projectEn?.data.title ?? project.data.title;
const descriptionEn = projectEn?.data.description ?? project.data.description;
const roleEn = projectEn?.data.role ?? project.data.role;

const demoLabelEn = project.data.category === "Game Dev" ? "Play on itch.io" : "Live Demo";
const demoLabelId = project.data.category === "Game Dev" ? "Play di itch.io" : "Live Demo";
---

<BaseLayout title={titleEn} description={descriptionEn} sideBarActiveItemID={sideBarActiveItemID}>
<div class="rounded-lg bg-base-200 overflow-hidden border border-base-300 p-5 sm:p-8 mb-6">
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><a href={backHref}>{backLabel}</a></li>
      <li><Dual en={titleEn} id={project.data.title} /></li>
    </ul>
  </div>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <span class="badge badge-secondary">{project.data.category}</span>
    {project.data.period && (
      <span class="badge badge-outline">
        <Dual en={projectEn?.data.period ?? project.data.period} id={project.data.period} />
      </span>
    )}
  </div>

  <h1 class="text-4xl font-bold mb-3"><Dual en={titleEn} id={project.data.title} /></h1>
  <p class="text-lg opacity-80 mb-4"><Dual en={descriptionEn} id={project.data.description} /></p>

  {roleEn && <div class="text-sm opacity-70 mb-4"><Dual en={`Role: ${roleEn}`} id={`Peran: ${project.data.role}`} /></div>}

  <div class="flex flex-wrap gap-2 mb-6">
    {project.data.tech.map((item) => <span class="badge badge-outline">{item}</span>)}
  </div>

  {
    (project.data.repo || project.data.demo) && (
      <div class="flex flex-wrap gap-2 mb-8">
        {project.data.repo && (
          <a class="btn btn-sm" href={project.data.repo} target="_blank" rel="noopener noreferrer">
            GitHub Repository
          </a>
        )}
        {project.data.demo && (
          <a class="btn btn-sm btn-outline" href={project.data.demo} target="_blank" rel="noopener noreferrer">
            <Dual en={demoLabelEn} id={demoLabelId} />
          </a>
        )}
      </div>
    )
  }

  {
    project.data.gallery.length > 0 && (
      <section class="mb-10">
        <h2 class="text-3xl font-bold mb-4"><Dual en="Documentation" id="Dokumentasi" /></h2>
        <ImageCarousel images={project.data.gallery} alt={titleEn} />
      </section>
    )
  }

  <div class="divider my-4"></div>

  <article class="prose prose-lg max-w-none" data-lang-block="en">
    <ContentEn />
  </article>
  <article class="prose prose-lg max-w-none" data-lang-block="id">
    <ContentId />
  </article>

  </div>

  <div class="divider my-8"></div>

  <a class="btn btn-outline" href={backHref}>← <Dual en={`Back to ${backLabel}`} id={`Kembali ke ${backLabel}`} /></a>
</BaseLayout>