---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";

interface Props {
  project: CollectionEntry<"projects">;
  sideBarActiveItemID: string;
  backHref: string;
  backLabel: string;
  categoryHref?: string;
}

const { project, sideBarActiveItemID, backHref, backLabel, categoryHref } = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={project.data.title} description={project.data.description} sideBarActiveItemID={sideBarActiveItemID}>
  <div class="text-sm breadcrumbs mb-4">
    <ul>
      <li><a href={backHref}>{backLabel}</a></li>
      {categoryHref && <li><a href={categoryHref}>{project.data.category}</a></li>}
      <li>{project.data.title}</li>
    </ul>
  </div>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <span class="badge badge-secondary">{project.data.category}</span>
    {project.data.period && <span class="badge badge-outline">{project.data.period}</span>}
  </div>

  <h1 class="text-4xl font-bold mb-3">{project.data.title}</h1>
  <p class="text-lg opacity-80 mb-4">{project.data.description}</p>

  {project.data.role && <div class="text-sm opacity-70 mb-4">Peran: {project.data.role}</div>}

  <div class="flex flex-wrap gap-2 mb-6">
    {project.data.tech.map((item) => <span class="badge badge-outline">{item}</span>)}
  </div>

  {
    (project.data.repo || project.data.demo) && (
      <div class="flex flex-wrap gap-2 mb-8">
        {project.data.repo && (
          <a class="btn btn-sm" href={project.data.repo} target="_blank" rel="noopener noreferrer">
            GitHub Repository
          </a>
        )}
        {project.data.demo && (
          <a class="btn btn-sm btn-outline" href={project.data.demo} target="_blank" rel="noopener noreferrer">
            Live Demo
          </a>
        )}
      </div>
    )
  }

  {
    project.data.gallery.length > 0 && (
      <section class="mb-10">
        <h2 class="text-3xl font-bold mb-4">Dokumentasi</h2>
        <ImageCarousel images={project.data.gallery} alt={project.data.title} />
      </section>
    )
  }

  <div class="divider my-4"></div>

  <article class="prose prose-lg max-w-none">
    <Content />
  </article>

  <div class="divider my-8"></div>

  <a class="btn btn-outline" href={backHref}>← Kembali ke {backLabel}</a>
</BaseLayout>