---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import LanguageScript from "../components/LanguageScript.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-lang="en" data-theme="lofi">
  <head>
    <script is:inline>
      try {
        document.documentElement.dataset.lang = localStorage.getItem("lang") === "id" ? "id" : "en";
      } catch (e) {}
    </script>
    <BaseHead title={title} description={description} image={image} , ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <LanguageScript />
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100 flex flex-col min-h-screen">
        <Header title={SITE_TITLE} />
        <div class="md:flex md:justify-center grow">
          <main class:list={["p-6 pt-10 w-full", wide ? "lg:max-w-[1100px]" : "lg:max-w-[900px]"]}>
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"ecaaec73e3164f50a0314154c6cfeee4"}'></script>
  </body>
</html>
